# Copier ce fichier vers ".env" puis adapter les valeurs si besoin.
# cp .env.example .env

# Connexion à MySQL/MariaDB fourni par XAMPP.
# On utilise 127.0.0.1 plutôt que "localhost" : avec MySQL, "localhost" pousse
# le client à essayer une connexion par socket Unix (dont le chemin varie selon
# l'installation XAMPP) au lieu d'une connexion TCP classique. 127.0.0.1 force le TCP
# et évite les erreurs "Can't connect to local MySQL server through socket".
DATABASE_URL="mysql://root:@127.0.0.1:3306/jobtrack"

# Auth.js (ex NextAuth) : clé de signature des JWT de session.
# Générer une valeur avec : openssl rand -base64 32
AUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"
